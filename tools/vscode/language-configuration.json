{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_\\u00C0-\\u024F\\u0370-\\u03FF→%][A-Za-z0-9_\\u00C0-\\u024F\\u0370-\\u03FF→.]*|#[0-9A-Fa-f]+[bodhBODH]?|-?\\d+(\\.\\d+)?",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(.*\\b(BEGIN|THEN|DO|REPEAT|ELSE|CASE|IFERR)\\b)\\s*(//.*)?$",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(END|UNTIL|ELSE)\\b",
      "flags": "i"
    }
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#region\\b",
      "end": "^\\s*//\\s*#endregion\\b"
    }
  }
}
